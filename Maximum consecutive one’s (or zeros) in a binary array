class Solution:
  def maxconsecutiveonesozeroes(arr: list[int]) -> int:
    if not arr:
        return 0

    max_count = 0
    current_count = 0

    for i in range(len(arr)):
        if i == 0 or arr[i] == arr[i - 1]:
            current_count += 1
        else:
            current_count = 1
        
        max_count = max(max_count, current_count)

    return max_count
